# Optional second analytics source. The built in first party pipeline in
# data/events.json runs whether or not these are set.
#
# Google Analytics 4 measurement id, looks like G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
#
# Plausible, set to the domain you registered, for example ratio.com.au
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Guards the endpoints that read back customer submissions:
#   GET /api/orders, GET /api/events, and /insights
# Unset in production means those are denied, not opened.
RATIO_ADMIN_TOKEN=
